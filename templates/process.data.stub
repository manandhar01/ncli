import { UnauthorizedException } from '@nestjs/common';
import { OwnershipScope } from '../../common/libraries/ownership.scope';
import { ProcessCommonData } from '../../common/libraries/process.common.data';
import { Add{{ProcessorName}}Dto } from '../dtos/add.{{processor_file}}.dto';
import { {{EntityName}}Entity } from '../entities/{{entity_file}}.entity';

export class Process{{ProcessorName}}Data extends ProcessCommonData {
    protected payload: Add{{ProcessorName}}Dto;

    constructor(private readonly scope: OwnershipScope) {
        super();
    }

    async process(payload: Add{{ProcessorName}}Dto) {
        this.payload = payload;

        await this.validate();

        return this.create();
    }

    private async create() {
        const record = await this.getOrCreateRecord();
        if (!this.scope.owns(record)) throw new UnauthorizedException();

        this.assignPayloadToRecord(record);
        return record.save();
    }

    private async getOrCreateRecord() {
        if (this.payload.id) return {{EntityName}}Entity.first(this.payload.id);

        return this.scope.stamp({{EntityName}}Entity.create());
    }

    private assignPayloadToRecord(_record: {{EntityName}}Entity) {}

    private async validate() {
        this.throwExceptionOnError();
    }
}
