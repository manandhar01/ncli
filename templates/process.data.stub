import { ProcessCommonData } from '../../common/libraries/process.common.data';


export class Process{{ProcessorName}}Data extends ProcessCommonData {
    protected payload: Add{{EntityName}}Dto;

    constructor(private readonly business: BusinessEntity) {
        super();
    }

    async process(payload: Add{{EntityName}}Dto) {
        this.payload = payload;

        await this.validate();

        return this.create();
    }

    private async create() {
        let record = {{EntityName}}Entity.create();
        if (this.payload.id) record = await {{EntityName}}Entity.first(this.payload.id);
        if (record?.business_id !== this.business.id) throw new UnauthorizedException();

        return record.save();
    }

    private async validate() {
        this.throwExceptionOnError()
    }
}
