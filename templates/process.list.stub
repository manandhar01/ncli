import { SelectQueryBuilder } from 'typeorm';
import { ListConfigOptionsDto } from '../../common/dtos/list.config.options.dto';
import { OwnershipScope } from '../../common/libraries/ownership.scope';
import { ProcessCommonList } from '../../common/libraries/process.common.list';
import { {{ListingName}}ListFilterDto } from '../dtos/{{listing_file}}.list.filter.dto';
import { {{EntityName}}Entity } from '../entities/{{entity_file}}.entity';

export class Process{{ListingName}}List extends ProcessCommonList<{{EntityName}}Entity> {
    protected entity: new () => {{EntityName}}Entity = {{EntityName}}Entity;
    protected payload: {{ListingName}}ListFilterDto;

    protected config: ListConfigOptionsDto<{{EntityName}}Entity> = {
        searchableColumns: [],
        orderBy: 'created_at',
        orderDirection: 'DESC',
    };

    constructor(private readonly scope: OwnershipScope) {
        super();
    }

    async process(payload: {{ListingName}}ListFilterDto) {
        this.payload = { ...payload };
        return this.handle();
    }

    protected applyCustomFilters(qb: SelectQueryBuilder<{{EntityName}}Entity>) {
        this.scope.applyTo(qb);
    }
}
