@Injectable()
export class {{ServiceName}}Service {
    async updateActiveStatus(
        id: number,
        is_active: boolean,
    ): Promise<{{EntityName}}Entity> {
        const record = await {{EntityName}}Entity.first(id);
        if (!record) throw new UnauthorizedException();

        record.is_active = is_active;
        return record.save();
    }
}
