import {
    Body,
    ClassSerializerInterceptor,
    Controller,
    Delete,
    Get,
    Param,
    Patch,
    Post,
    UnauthorizedException,
    UseInterceptors,
} from '@nestjs/common';
import { BusinessAccessService } from '../../business/services/business.access.service';
import { CommonParamDto } from '../../common/dtos/common.param.dto';
import { OwnershipScope } from '../../common/libraries/ownership.scope';
import { ProcessCommonFind } from '../../common/libraries/process.common.find';
import { Add{{ControllerName}}Dto } from '../dtos/add.{{controller_file}}.dto';
import { {{ControllerName}}FindDto } from '../dtos/{{controller_file}}.find.dto';
import { {{ControllerName}}ListFilterDto } from '../dtos/{{controller_file}}.list.filter.dto';
import { {{EntityName}}Entity } from '../entities/{{entity_file}}.entity';
import { {{name_camel}}FindConfig } from '../libraries/{{controller_file}}.find.config';
import { Process{{ControllerName}}Data } from '../libraries/process.{{controller_file}}.data';
import { Process{{ControllerName}}List } from '../libraries/process.{{controller_file}}.list';
import { Business{{ControllerName}}Service } from '../services/business.{{controller_file}}.service';

@Controller('business/')
export class Business{{ControllerName}}Controller {
    constructor(
        private readonly business{{ControllerName}}Service: Business{{ControllerName}}Service,
        private readonly businessAccessService: BusinessAccessService,
    ) {}

    @Post('search')
    async search(@Body() body: {{ControllerName}}ListFilterDto) {
        const business = await this.businessAccessService.validateAccess();

        return new Process{{ControllerName}}List(
            OwnershipScope.forBusiness(business),
        ).process(body);
    }

    @Post('find')
    async find(@Body() body: {{ControllerName}}FindDto) {
        const business = await this.businessAccessService.validateAccess();

        return new ProcessCommonFind(
            {{EntityName}}Entity,
            {{name_camel}}FindConfig(OwnershipScope.forBusiness(business)),
        ).process(body);
    }

    @Post()
    async create(@Body() body: Add{{ControllerName}}Dto) {
        const business = await this.businessAccessService.validateAccess();

        return new Process{{ControllerName}}Data(
            OwnershipScope.forBusiness(business),
        ).process(body);
    }

    @UseInterceptors(ClassSerializerInterceptor)
    @Get(':id')
    async show(@Param() params: CommonParamDto) {
        const business = await this.businessAccessService.validateAccess();

        const record = await {{EntityName}}Entity.first(params.id, {
            relations: [],
        });
        if (!OwnershipScope.forBusiness(business).owns(record))
            throw new UnauthorizedException();

        return record;
    }

    @Patch(':id/activate')
    @UseInterceptors(ClassSerializerInterceptor)
    async activate(@Param() params: CommonParamDto) {
        const business = await this.businessAccessService.validateAccess();

        return this.business{{ControllerName}}Service.updateActiveStatus(
            params.id,
            business.id,
            true,
        );
    }

    @Patch(':id/deactivate')
    @UseInterceptors(ClassSerializerInterceptor)
    async deactivate(@Param() params: CommonParamDto) {
        const business = await this.businessAccessService.validateAccess();

        return this.business{{ControllerName}}Service.updateActiveStatus(
            params.id,
            business.id,
            false,
        );
    }

    @UseInterceptors(ClassSerializerInterceptor)
    @Delete(':id')
    async remove(@Param() params: CommonParamDto) {
        const business = await this.businessAccessService.validateAccess();

        const record = await {{EntityName}}Entity.first(params.id);
        if (!OwnershipScope.forBusiness(business).owns(record))
            throw new UnauthorizedException();

        return record.softDelete();
    }
}
