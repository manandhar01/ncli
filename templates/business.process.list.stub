import { ListConfigOptionsDto } from '../../common/dtos/list.config.options.dto';
import { ProcessCommonList } from '../../common/libraries/process.common.list';


export class ProcessBusiness{{ListingName}}List extends ProcessCommonList<{{EntityName}}Entity> {
    protected entity: new () => {{EntityName}}Entity = {{EntityName}}Entity;
    protected payload: Business{{ListingName}}ListFilterDto;

    protected config: ListConfigOptionsDto<{{EntityName}}Entity> = {
        searchableColumns: [],
        orderBy: '',
        orderDirection: '',
    };

    constructor(private readonly business: BusinessEntity) {
        super();
    }

    async process(payload: Business{{EntityName}}ListFilterDto) {
        this.payload = { ...payload };
